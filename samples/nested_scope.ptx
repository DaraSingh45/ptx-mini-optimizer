// Inline-asm style nested { } scope: ptx-opt must keep such functions verbatim (and say so).
.version 7.8
.target sm_75
.address_size 64

.visible .entry usesAsm(
	.param .u64 usesAsm_param_0
)
{
	.reg .b32 	%r<4>;
	.reg .b64 	%rd<3>;

	ld.param.u64 	%rd1, [usesAsm_param_0];
	mov.u32 	%r1, %tid.x;
	{
	.reg .b32 temp;
	add.u32 temp, %r1, 1;
	mov.u32 %r2, temp;
	}
	st.global.u32 	[%rd1], %r2;
	ret;

}
