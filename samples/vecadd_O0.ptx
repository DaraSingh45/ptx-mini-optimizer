//
// Hand-written in the style of unoptimised nvcc output (-G / -Xcicc -O0), with
// .file/.loc line info, redundant moves and duplicated address computations.
//
.version 7.8
.target sm_75
.address_size 64

	// .globl	vecAdd
.file	1 "/tmp/vecadd.cu"

.visible .entry vecAdd(
	.param .u64 vecAdd_param_0,
	.param .u64 vecAdd_param_1,
	.param .u64 vecAdd_param_2,
	.param .u32 vecAdd_param_3
)
{
	.reg .pred 	%p<3>;
	.reg .f32 	%f<8>;
	.reg .b32 	%r<14>;
	.reg .b64 	%rd<24>;

	.loc	1 2 1
	ld.param.u64 	%rd1, [vecAdd_param_0];
	ld.param.u64 	%rd2, [vecAdd_param_1];
	ld.param.u64 	%rd3, [vecAdd_param_2];
	ld.param.u32 	%r1, [vecAdd_param_3];
	.loc	1 3 7
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r3, %ntid.x;
	mul.lo.s32 	%r4, %r2, %r3;
	mov.u32 	%r5, %tid.x;
	add.s32 	%r6, %r4, %r5;
	mov.u32 	%r7, %r6;
	.loc	1 4 7
	mov.u32 	%r8, %r7;
	mov.u32 	%r9, %r1;
	setp.lt.s32 	%p1, %r8, %r9;
	not.pred 	%p2, %p1;
	@%p2 bra 	$L__BB0_2;
	bra.uni 	$L__BB0_1;

$L__BB0_1:
	.loc	1 4 20
	cvta.to.global.u64 	%rd4, %rd1;
	mov.u32 	%r10, %r7;
	mul.wide.s32 	%rd5, %r10, 4;
	add.s64 	%rd6, %rd4, %rd5;
	ld.global.f32 	%f1, [%rd6];
	cvta.to.global.u64 	%rd7, %rd2;
	mov.u32 	%r11, %r7;
	mul.wide.s32 	%rd8, %r11, 4;
	add.s64 	%rd9, %rd7, %rd8;
	ld.global.f32 	%f2, [%rd9];
	add.f32 	%f3, %f1, %f2;
	cvta.to.global.u64 	%rd10, %rd3;
	mov.u32 	%r12, %r7;
	mul.wide.s32 	%rd11, %r12, 4;
	add.s64 	%rd12, %rd10, %rd11;
	st.global.f32 	[%rd12], %f3;
	bra.uni 	$L__BB0_2;

$L__BB0_2:
	.loc	1 5 1
	ret;

}
